APP_NAME="Lomba Diskominfo"
APP_ENV=production
APP_KEY=base64:generate-a-random-32-byte-key
APP_DEBUG=false
APP_URL=https://lomba.indramayukab.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

ADMIN_EMAIL=admin@lomba.indramayukab.go.id
ADMIN_PASSWORD=generate-a-random-password
LOMBA_SESSION_PIN=000000

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lomba
DB_USERNAME=lomba
DB_PASSWORD=generate-a-random-password
DB_ROOT_PASSWORD=generate-a-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=generate-a-random-id
REVERB_APP_KEY=generate-a-random-key
REVERB_APP_SECRET=generate-a-random-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://lomba.indramayukab.go.id
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=lomba.indramayukab.go.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

FILESYSTEM_DISK=local
MAIL_MAILER=log
